{
  "name": "backendferiaamericana",
  "version": "1.0.0",
  "description": "Feria Americana Store Backend.",
  "homepage": "https://github.com/ValeSanguinetti/BackendFeriaAmericana#readme",
  "bugs": {
    "url": "https://github.com/ValeSanguinetti/BackendFeriaAmericana/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValeSanguinetti/BackendFeriaAmericana.git"
  },
  "license": "MIT",
  "author": "ValeSanguinetti & Duran24062005",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run src/tests"
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "prisma": "^6.17.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5"
  }
}
