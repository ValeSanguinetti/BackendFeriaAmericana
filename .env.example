NODE_ENV=development
PORT=8000
# Supabase PostgreSQL connection for Prisma.
# Prefer the Supavisor Session pooler string from Supabase Dashboard > Connect.
# DATABASE_URL needs the Supabase database password, not the publishable or secret API key.
# If the database password has special characters, URL-encode it before pasting it here.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD_URL_ENCODED@YOUR_DB_REGION.pooler.supabase.com:5432/postgres?schema=public&sslmode=require"
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Backend-only Supabase API key. Use a publishable key for low-privilege access or a secret key only for trusted server code.
SUPABASE_KEY="YOUR_SUPABASE_API_KEY"
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRE=7d
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
EMAIL_API_BASE_URL=http://localhost:8000
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SIGNED_URL_TTL_SECONDS=900
AWS_SIGNED_URL_REFRESH_MARGIN_SECONDS=60
